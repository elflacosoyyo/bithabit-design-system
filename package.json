{
  "name": "@bakia/bithabit-design-system",
  "version": "0.1.0",
  "description": "BITHABIT design system: white-label tokens, component specs and the contract layer between design and development.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elflacosoyyo/bithabit-design-system.git"
  },
  "files": [
    "brands",
    "components",
    "dist",
    "docs",
    "integration",
    "schemas"
  ],
  "exports": {
    "./themes/*": {
      "types": "./dist/*/theme.d.ts",
      "default": "./dist/*/theme.js"
    },
    "./tailwind-preset/*": "./dist/*/tailwind.preset.cjs",
    "./css/*": "./dist/*/tokens.css",
    "./manifest": "./dist/manifest.json",
    "./components/*": "./components/*",
    "./brands/*": "./brands/*",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json",
    "./css-compat/*": "./dist/*/bithabit-compat.css",
    "./integration/*": "./integration/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run validate && npm run build && npm run build-catalog && git diff --exit-code -- dist catalog",
    "typecheck": "tsc --noEmit",
    "ds-sync": "node integration/ds-sync/sync.mjs",
    "catalog": "vite catalog-src --open",
    "build-catalog": "node scripts/build-catalog.mjs",
    "test:catalog": "node scripts/test-catalog.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/yrsa": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^18.1.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "bin": {
    "ds-sync": "integration/ds-sync/sync.mjs"
  }
}
