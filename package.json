{
  "name": "@bakia/bithabit-design-system",
  "version": "0.1.0",
  "description": "BITHABIT design system: white-label tokens, component specs and the contract layer between design and development.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elflacosoyyo/bithabit-design-system.git"
  },
  "files": [
    "dist",
    "components",
    "brands",
    "schemas",
    "docs"
  ],
  "exports": {
    "./themes/*": {
      "types": "./dist/*/theme.d.ts",
      "default": "./dist/*/theme.js"
    },
    "./tailwind-preset/*": "./dist/*/tailwind.preset.cjs",
    "./css/*": "./dist/*/tokens.css",
    "./manifest": "./dist/manifest.json",
    "./components/*": "./components/*",
    "./brands/*": "./brands/*",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json",
    "./css-compat/*": "./dist/*/bithabit-compat.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run validate && npm run build && git diff --exit-code -- dist",
    "typecheck": "tsc --noEmit",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build",
    "build-storybook": "storybook build -o storybook-static --disable-telemetry",
    "test:stories": "node scripts/smoke-stories.mjs",
    "chromatic": "chromatic --exit-zero-on-changes --build-script-name build-storybook"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/yrsa": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^18.12.0",
    "marked": "^18.1.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
