{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakia.dev/bithabit/screen.schema.json",
  "title": "BITHABIT screen recreation",
  "description": "A real app screen recreated in the catalog from design-system components, with the designer's annotations. Documentation only: it is not part of the public manifest.",
  "type": "object",
  "required": ["id", "name", "version", "status", "summary", "route", "components", "states", "annotations", "sources", "changelog"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "reviewed"] },
    "summary": { "type": "string", "minLength": 10 },
    "route": { "type": "string", "description": "Where the screen lives in the app (Expo Router path)." },
    "components": {
      "type": "array",
      "minItems": 1,
      "description": "Design-system components the recreation uses. Each id must exist in components/inventory.yaml.",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "role": { "type": "string" } }
      }
    },
    "pending": {
      "type": "array",
      "description": "Parts of the real screen that are not recreated or have no component yet.",
      "items": {
        "type": "object",
        "required": ["name", "note"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "note": { "type": "string" }, "needs": { "type": "array", "items": { "type": "string" }, "description": "Inventory ids that would cover it." } }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "target", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]\\d+$" },
          "type": { "enum": ["note", "gap", "question", "decision"] },
          "target": { "type": "string", "description": "Anchor id of the element the pin is attached to (data-anno in the recreation)." },
          "component": { "type": "string", "description": "Inventory id the note is about." },
          "decision": { "type": "string", "pattern": "^D-\\d+$", "description": "A decision in audit/decisions.md." },
          "text": { "type": "string", "minLength": 5 }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figma": { "type": "array", "items": { "type": "object", "required": ["file", "node"], "properties": { "file": { "type": "string" }, "node": { "type": "string" }, "name": { "type": "string" } } } },
        "code": { "type": "array", "items": { "type": "object", "required": ["repo", "path", "verified"], "properties": { "repo": { "type": "string" }, "path": { "type": "string" }, "verified": { "type": "boolean" }, "commit": { "type": "string" } } } }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date", "changes"],
        "additionalProperties": false,
        "properties": { "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "changes": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
      }
    }
  }
}
