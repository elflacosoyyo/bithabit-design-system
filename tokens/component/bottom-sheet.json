{
  "bottom-sheet": {
    "bg": {
      "$value": "{color.bg.canvas}",
      "$type": "color"
    },
    "radius-top": {
      "$value": "{radius.2xl}",
      "$type": "dimension"
    },
    "handle": {
      "width": {
        "$value": "40px",
        "$type": "dimension"
      },
      "height": {
        "$value": "{spacing.xs}",
        "$type": "dimension"
      },
      "radius": {
        "$value": "{radius.pill}",
        "$type": "dimension"
      },
      "bg": {
        "$value": "{color.text.secondary}",
        "$type": "color"
      },
      "padding-y": {
        "$value": "{spacing.sm}",
        "$type": "dimension"
      }
    },
    "backdrop": {
      "$value": "{color.bg.overlay}",
      "$type": "color"
    },
    "backdrop-opacity": {
      "$value": "{opacity.backdrop}",
      "$type": "number"
    },
    "duration": {
      "$value": "{motion.duration.base}",
      "$type": "duration"
    },
    "drag-threshold": {
      "$value": "100px",
      "$type": "dimension"
    },
    "velocity-threshold": {
      "$value": 500,
      "$type": "number"
    },
    "spring-damping": {
      "$value": 25,
      "$type": "number"
    },
    "spring-stiffness": {
      "$value": 100,
      "$type": "number"
    }
  }
}
