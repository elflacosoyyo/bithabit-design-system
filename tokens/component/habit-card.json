{
  "habit-card": {
    "bg": {
      "$value": "{color.bg.surface}",
      "$type": "color"
    },
    "wrapper-bg": {
      "$value": "{color.bg.canvas}",
      "$type": "color"
    },
    "text": {
      "$value": "{color.text.primary}",
      "$type": "color"
    },
    "font-size": {
      "$value": "{font.size.sm}",
      "$type": "dimension"
    },
    "font-weight": {
      "$value": "{font.weight.light}",
      "$type": "fontWeight"
    },
    "letter-spacing": {
      "$value": "0.35px",
      "$type": "dimension"
    },
    "padding-x": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "padding-y": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "list-padding-x": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "list-padding-y": {
      "$value": "{spacing.xs}",
      "$type": "dimension"
    },
    "radius-top": {
      "$value": "{radius.sm}",
      "$type": "dimension"
    },
    "radius-bottom": {
      "$value": "{radius.none}",
      "$type": "dimension"
    },
    "pressed-opacity": {
      "$value": "{opacity.pressed}",
      "$type": "number"
    },
    "strip": {
      "height": {
        "$value": "{spacing.xs}",
        "$type": "dimension"
      },
      "gap": {
        "$value": "{spacing.2xs}",
        "$type": "dimension"
      },
      "segments": {
        "$value": 7,
        "$type": "number"
      },
      "segment-filled": {
        "$value": "{color.accent.default}",
        "$type": "color"
      },
      "segment-empty": {
        "$value": "{color.bg.surface-alt}",
        "$type": "color"
      }
    },
    "swipe": {
      "toggle-bg": {
        "$value": "{color.accent.default}",
        "$type": "color"
      },
      "delete-bg": {
        "$value": "{color.status.destructive}",
        "$type": "color"
      },
      "label": {
        "$value": "{color.text.on-accent}",
        "$type": "color"
      },
      "label-size": {
        "$value": "{font.size.body}",
        "$type": "dimension"
      },
      "label-weight": {
        "$value": "{font.weight.semibold}",
        "$type": "fontWeight"
      },
      "threshold": {
        "$value": "80px",
        "$type": "dimension"
      },
      "velocity-threshold": {
        "$value": 500,
        "$type": "number"
      },
      "reveal-width": {
        "$value": "100px",
        "$type": "dimension"
      },
      "snap-duration": {
        "$value": "{motion.duration.fast}",
        "$type": "duration"
      },
      "return-duration": {
        "$value": "{motion.duration.short}",
        "$type": "duration"
      }
    }
  }
}
