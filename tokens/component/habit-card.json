{
  "habit-card": {
    "bg": {
      "$value": "{color.bg.surface}",
      "$type": "color"
    },
    "text": {
      "$value": "{color.text.primary}",
      "$type": "color"
    },
    "font-size": {
      "$value": "{font.size.sm}",
      "$type": "dimension"
    },
    "font-weight": {
      "$value": "{font.weight.light}",
      "$type": "fontWeight"
    },
    "padding-x": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "padding-y": {
      "$value": "{spacing.md}",
      "$type": "dimension"
    },
    "radius-top": {
      "$value": "{radius.sm}",
      "$type": "dimension"
    },
    "radius-bottom": {
      "$value": "{radius.none}",
      "$type": "dimension"
    },
    "pressed-opacity": {
      "$value": "{opacity.pressed}",
      "$type": "number"
    },
    "strip": {
      "height": {
        "$value": "3px",
        "$type": "dimension"
      },
      "gap": {
        "$value": "{spacing.xs}",
        "$type": "dimension"
      },
      "segment-filled": {
        "$value": "{color.accent.default}",
        "$type": "color"
      },
      "segment-empty": {
        "$value": "{color.bg.surface-alt}",
        "$type": "color"
      }
    }
  }
}